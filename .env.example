# Copy to .env.local and fill in only what you need. Every value is optional:
# with none of them set, Preflight runs in sample mode with no network call.
# Never commit a filled-in copy of this file.

# `live` opts into live data. Anything else, including empty, is sample mode.
PREFLIGHT_DATA=

# SQLite file. Defaults to ./preflight.db locally; /data/preflight.db in the
# container, which is where the persistent volume is mounted.
PREFLIGHT_DB_PATH=

# Overrides the gate G1 probe, to exercise its failure path.
PREFLIGHT_PROBE_URL=

# Price-history fallback (Tiingo end-of-day).
TIINGO_API_KEY=

# Options-chain fallback (Tradier sandbox).
TRADIER_SANDBOX_TOKEN=

# Earnings-date fallback (Finnhub).
FINNHUB_API_KEY=

# Enables the optional plain-language explainer. Without it the deterministic
# template is used, which is not an error.
ANTHROPIC_API_KEY=
